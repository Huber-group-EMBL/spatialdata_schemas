{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "points.schema",
  "title": "SpatialData points element attributes",
  "description": "The zarr.json attributes key for a points/{name} group in a SpatialData v0.3 store",
  "allOf": [
    { "$ref": "_spatial_element.schema" },
    {
      "type": "object",
      "properties": {
        "encoding-type": {
          "type": "string",
          "const": "ngff:points"
        }
      },
      "required": ["encoding-type"]
    }
  ]
}
